{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pedsafety/phase4/image_kinematics_sidecar/1.0.0",
  "title": "Phase 4 Task 2 image-space kinematics sidecar row",
  "description": "One derived row per input observation. Separate from, and never merged into, the canonical agent-state schema (docs/phase2/schemas/agent_state.schema.json). Image space only: pixels, seconds, image-plane radians. No world or physical quantity is represented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "view", "source_line", "track_id", "sequence_id", "scene_id", "source_dataset", "agent_class",
    "frame_index", "timestamp", "coordinate_system", "coordinate_space", "position_unit", "velocity_unit", "acceleration_unit",
    "heading_unit", "time_unit", "heading_convention", "position_source", "position_x", "position_y", "position_state",
    "observation_type", "interpolated", "causal_estimate", "bbox_touches_border", "dt_s", "frame_gap_before",
    "velocity_x", "velocity_y", "speed", "velocity_state", "velocity_method",
    "acceleration_x", "acceleration_y", "acceleration_state", "acceleration_method", "heading", "heading_state",
    "filter_kind", "filtered_position_x", "filtered_position_y", "filtered_velocity_x", "filtered_velocity_y", "filtered_speed",
    "filtered_velocity_state", "filtered_acceleration_x", "filtered_acceleration_y", "filtered_acceleration_state",
    "filtered_heading", "filtered_heading_state", "world_x", "world_y", "world_position_valid"
  ],
  "properties": {
    "schema_version": {"const": "image-kinematics-sidecar-1.0.0"},
    "view": {"enum": ["CAUSAL", "OFFLINE_NON_CAUSAL"]},
    "source_line": {"type": "integer", "minimum": 1},
    "track_id": {"type": "string", "minLength": 1},
    "sequence_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": ["string", "null"]},
    "source_dataset": {"type": ["string", "null"]},
    "agent_class": {"type": ["string", "null"]},
    "frame_index": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "number"},
    "coordinate_system": {"type": ["string", "null"]},
    "coordinate_space": {"const": "image"},
    "position_unit": {"const": "pixel"},
    "velocity_unit": {"const": "pixel/s"},
    "acceleration_unit": {"const": "pixel/s^2"},
    "heading_unit": {"const": "rad"},
    "time_unit": {"const": "s"},
    "heading_convention": {"const": "image_atan2_vy_vx_from_+u_toward_+v_clockwise_on_screen_range_[-pi,pi)",
                           "description": "heading = atan2(v_y, v_x) in image axes (origin top-left, +u right, +v down): angle from +u toward +v, so positive is clockwise on screen; range [-pi, pi); not a world heading. The full sentence is repeated in run_manifest.json conventions.heading_convention."},
    "position_source": {"const": "footpoint_bottom_centre"},
    "position_x": {"type": ["number", "null"]},
    "position_y": {"type": ["number", "null"]},
    "position_state": {"type": "string", "minLength": 1},
    "observation_type": {"enum": ["observed", "invalid", "rejected"]},
    "interpolated": {"const": false},
    "causal_estimate": {"const": false},
    "bbox_touches_border": {"type": ["boolean", "null"]},
    "dt_s": {"type": ["number", "null"]},
    "frame_gap_before": {"type": ["integer", "null"], "minimum": 0},
    "velocity_x": {"type": ["number", "null"]},
    "velocity_y": {"type": ["number", "null"]},
    "speed": {"type": ["number", "null"], "minimum": 0},
    "velocity_state": {"type": "string", "minLength": 1},
    "velocity_method": {"enum": ["backward_difference_actual_dt", "central_difference_actual_dt"]},
    "acceleration_x": {"type": ["number", "null"]},
    "acceleration_y": {"type": ["number", "null"]},
    "acceleration_state": {"type": "string", "minLength": 1},
    "acceleration_method": {"enum": ["backward_difference_of_backward_velocity_actual_dt", "nonuniform_second_central_difference_actual_dt"]},
    "heading": {"type": ["number", "null"], "minimum": -3.141592653589794, "maximum": 3.141592653589794},
    "heading_state": {"type": "string", "minLength": 1},
    "filter_kind": {"enum": ["none", "causal_ema", "time_aware_ema"]},
    "filtered_position_x": {"type": ["number", "null"]},
    "filtered_position_y": {"type": ["number", "null"]},
    "filtered_velocity_x": {"type": ["number", "null"]},
    "filtered_velocity_y": {"type": ["number", "null"]},
    "filtered_speed": {"type": ["number", "null"], "minimum": 0},
    "filtered_velocity_state": {"type": ["string", "null"]},
    "filtered_acceleration_x": {"type": ["number", "null"]},
    "filtered_acceleration_y": {"type": ["number", "null"]},
    "filtered_acceleration_state": {"type": ["string", "null"]},
    "filtered_heading": {"type": ["number", "null"], "minimum": -3.141592653589794, "maximum": 3.141592653589794},
    "filtered_heading_state": {"type": ["string", "null"]},
    "world_x": {"type": "null"},
    "world_y": {"type": "null"},
    "world_position_valid": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"velocity_state": {"const": "valid"}}},
     "then": {"properties": {"velocity_x": {"type": "number"}, "velocity_y": {"type": "number"}, "speed": {"type": "number"}, "dt_s": {"type": "number", "exclusiveMinimum": 0}}},
     "else": {"properties": {"velocity_x": {"type": "null"}, "velocity_y": {"type": "null"}, "speed": {"type": "null"}}}},
    {"if": {"properties": {"acceleration_state": {"const": "valid"}}},
     "then": {"properties": {"acceleration_x": {"type": "number"}, "acceleration_y": {"type": "number"}}},
     "else": {"properties": {"acceleration_x": {"type": "null"}, "acceleration_y": {"type": "null"}}}},
    {"if": {"properties": {"heading_state": {"const": "valid"}}},
     "then": {"properties": {"heading": {"type": "number"}}},
     "else": {"properties": {"heading": {"type": "null"}}}},
    {"if": {"properties": {"position_state": {"const": "ok"}}},
     "then": {"properties": {"position_x": {"type": "number"}, "position_y": {"type": "number"}}}},
    {"if": {"properties": {"view": {"const": "CAUSAL"}}},
     "then": {"properties": {"velocity_method": {"const": "backward_difference_actual_dt"}, "acceleration_method": {"const": "backward_difference_of_backward_velocity_actual_dt"}}},
     "else": {"properties": {"velocity_method": {"const": "central_difference_actual_dt"}, "acceleration_method": {"const": "nonuniform_second_central_difference_actual_dt"}, "filter_kind": {"const": "none"}}}},
    {"if": {"properties": {"filter_kind": {"const": "none"}}},
     "then": {"properties": {"filtered_position_x": {"type": "null"}, "filtered_position_y": {"type": "null"}, "filtered_velocity_x": {"type": "null"}, "filtered_velocity_y": {"type": "null"}, "filtered_speed": {"type": "null"}, "filtered_velocity_state": {"type": "null"}, "filtered_acceleration_x": {"type": "null"}, "filtered_acceleration_y": {"type": "null"}, "filtered_acceleration_state": {"type": "null"}, "filtered_heading": {"type": "null"}, "filtered_heading_state": {"type": "null"}}}}
  ]
}

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# --- Phase 2-4 baseline snapshot additions ---
# Generated, regenerable run artifacts (kept locally, not versioned)
/outputs/*
!/outputs/colab_bundle_v2/
!/outputs/colab_bundle_task4/
/outputs/colab_bundle_v2/*
/outputs/colab_bundle_task4/*
!/outputs/colab_bundle_v2/*.manifest.json
!/outputs/colab_bundle_task4/*.manifest.json
# Raw 20.7 MB grep dump from the Phase 2 Task 7 audit (kept locally, not versioned)
# SHA-256 2d1650888d2e40744f4854ab5b33f040bd28a6b6ee71eef4edf8d07b71f4b5e4, 20671873 bytes
/experiments/PCG_T4_5_Epoch_Run/logs/task7_coordinate_search.txt
# Evidence logs referenced by experiments/PCG_T4_5_Epoch_Run/manifest_v2.json (exceptions to the global *.log rule)
!/experiments/PCG_T4_5_Epoch_Run/logs/task8_pytest.log
!/experiments/PCG_T4_5_Epoch_Run/logs/task8_pytest_corrected_audit_fixes.log
# --- Phase 4 Task 2 additions ---
# Phase 3 PIE pilot inputs copied locally from Google Drive (102 MB, dataset-derived): never commit
/PIE_pilot_inputs/
# Real PIE kinematic sidecars (about 106 MB each); the reports, manifests and analysis JSON in the same run directory stay visible
/experiments/phase4_task2_pie_video_0004/**/*.jsonl
# Superseded synthetic runs: kept locally as historical evidence, not versioned unless their inclusion is approved
/experiments/phase4_task2_synthetic_validation/20261114T195051Z_smoothing/
/experiments/phase4_task2_synthetic_validation/20261114T195107Z_phase3_synthetic_replay_format_check/
# Phase 4 Task 3 real-pilot arrays (regenerable from committed code + hashed local inputs; ~21 MB per run); reports, manifests and JSON stay visible
/experiments/phase4_task3_pie_video_0004/**/*.npz
# Phase 5 P5.3 pilot window arrays (regenerable from committed code + hashed local Task 3 run; ~6.5 MB per run); manifests and reports stay visible
/experiments/phase5_task3_windows_pie_video_0004/**/*.npz
